# mugsun-pc nginx 配置模板（envsubst 渲染，仅替换 MUGSUN_* 变量）
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;
  client_max_body_size 50m;

  gzip on;
  gzip_static on;
  gzip_vary on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml application/wasm font/ttf font/otf;

  # 健康检查（不打访问日志）
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # 后端反代：/api/xxx → ${MUGSUN_API_UPSTREAM}/xxx（含 WebSocket）
  location /api/ {
    proxy_pass ${MUGSUN_API_UPSTREAM}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 300s;
    proxy_buffering off;
  }

  # 带 hash 的构建产物：一年 + immutable
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # Cesium 等无 hash 的静态资源：短缓存，缺失直接 404（不回落 index.html）
  location /cesiumStatic/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=86400" always;
    try_files $uri =404;
  }

  # 入口页永不缓存，保证发版即生效
  location = /index.html {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache, no-store, must-revalidate" always;
  }

  # SPA history 回退
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri $uri/ /index.html;
  }
}
