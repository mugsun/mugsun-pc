# 安全响应头（每个返回内容的 location 都 include，避免 add_header 继承被覆盖）（envsubst 渲染到 /etc/nginx/conf.d/security-headers.inc，非 .conf 不会被 http 级 include）
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "SAMEORIGIN" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
# HSTS 只应在 HTTPS 终端开启；由外层 TLS 网关负责时在网关上加
# add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
# CSP 由 15-mugsun-gateway.sh 按 MUGSUN_CSP_MODE（report-only | enforce）生成到 csp-headers.inc（非 .conf，不会被 http 级 include）。
include /etc/nginx/conf.d/csp-headers.inc;
