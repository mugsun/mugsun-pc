# 【开发】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 请求基础路径（开发环境设置为 / 使用代理，生产环境设置为完整后端地址）
VITE_API_URL = /

# 代理目标地址（开发环境通过 Vite 代理转发请求到此地址，解决跨域问题）
VITE_API_PROXY_URL = http://localhost:8080

# Delete console
VITE_DROP_CONSOLE = false

# 接口传输密钥：登录后由 /api/crypto/bootstrap 下发到内存；构建期 VITE_CRYPTO_API_KEY 可选，
# 非空时须与后端一致（dev 可由后端写入被 gitignore 的 .env.local）。勿在此提交真实密钥。

# 滑块验证码开发期 mock（true 启用；仅 dev 生效，生产构建不含 mock 代码）
VITE_CAPTCHA_MOCK = false

# 埋点问数据开发期 mock（true 启用；仅 dev 生效，默认走真 API）
VITE_TRACK_ASK_MOCK = false
